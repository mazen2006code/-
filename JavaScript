// استدعاء البيانات باستخدام نفس الاسم 'products' و 'sales'
let products = JSON.parse(localStorage.getItem('products')) || [];
let sales = JSON.parse(localStorage.getItem('sales')) || [];

// دالة الحفظ يجب أن تستخدم نفس الأسماء أيضاً في الملفين
function saveData() {
    localStorage.setItem('products', JSON.stringify(products));
    localStorage.setItem('sales', JSON.stringify(sales));
}function searchProducts() {
    let term = document.getElementById('pos-search').value.toLowerCase();
    let filtered = products.filter(p => p.name.toLowerCase().includes(term));
    renderPOSProducts(filtered); // نحدث القائمة بناءً على البحث
}